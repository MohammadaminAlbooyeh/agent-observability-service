APP_NAME=agent-observability-service
DEBUG=False
DATABASE_URL=postgresql+asyncpg://obs:obs@localhost:5432/observability
# Comma-separated admin keys: full read/manage access and dashboard login.
ADMIN_API_KEYS=change-me-admin-key
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRE_MINUTES=60
# Set to True when served over HTTPS so the dashboard cookie is Secure.
COOKIE_SECURE=False
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD_SECONDS=60
# Background alert evaluation interval; 0 disables the scheduler.
ALERT_EVAL_INTERVAL_SECONDS=60
ALERT_COOLDOWN_SECONDS=900
# Any OpenAI-compatible /chat/completions endpoint for the LLM judge.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4
